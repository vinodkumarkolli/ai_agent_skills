        {
            "name": "11. Asset",
            "item": [
                {
                    "name": "Get Assets by PR Reference",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.data && jsonData.data.length > 0) {",
                                    "        pm.environment.set(\"assetName\", jsonData.data[0].name);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/resource/Asset?filters=[[\"purchase_receipt\", \"=\", \"{{prName}}\"]]",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "resource",
                                "Asset"
                            ],
                            "query": [
                                {
                                    "key": "filters",
                                    "value": "[[\"purchase_receipt\", \"=\", \"{{prName}}\"]]"
                                }
                            ]
                        },
                        "description": "Fetch any automatically created Asset documents linked to our Purchase Receipt and store the first Asset Name to environment variable `assetName`."
                    },
                    "response": []
                },
                {
                    "name": "Submit Asset manually",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"docstatus\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/resource/Asset/{{assetName}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "resource",
                                "Asset",
                                "{{assetName}}"
                            ]
                        },
                        "description": "Submit the Asset record manually (docstatus = 1)."
                    },
                    "response": []
