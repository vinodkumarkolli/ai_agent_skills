				{
					"name": "Get Compass Orders",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/method/connect_master.api.get_compass_orders?tab=Active&start=0&page_len=50",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"connect_master.api.get_compass_orders"
							],
							"query": [
								{
									"key": "tab",
									"value": "Active",
									"description": "Can be: 'Active' (submitted/assigned/accepted), 'Unresolved' (escalated/pushed), or 'History' (fulfilled/cancelled)"
								},
								{
									"key": "start",
									"value": "0"
								},
								{
									"key": "page_len",
									"value": "50"
								},
								{
									"key": "filters",
									"value": "{\"order_status\":\"Submitted\"}",
									"description": "Optional JSON string containing additional filters.",
									"disabled": true
								},
								{
									"key": "search",
									"value": "pincode",
									"description": "Optional search term.",
									"disabled": true
								}
							]
						},
						"description": "Fetches filtered and paginated list of Connect Orders matching current user's role permissions and active tab."
					},
					"response": []
				},
