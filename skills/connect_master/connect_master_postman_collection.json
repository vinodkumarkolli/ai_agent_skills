{
	"info": {
		"_postman_id": "c8fb775b-fb00-442d-bae1-cf37b53d9f79",
		"name": "Connect Master API",
		"description": "Postman collection to test and integrate with the Connect Master API endpoints for building the mobile/external clients. Supports passwordless OTP authentication and order lifecycle management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"description": "Endpoints to authenticate and verify user sessions.",
			"item": [
				{
					"name": "Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "email",
									"value": "customer@example.com",
									"description": "Email address of the user logging in.",
									"type": "text"
								},
								{
									"key": "full_name",
									"value": "Customer One",
									"description": "Required if the user does not exist in the system yet.",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/method/connect_master.api.send_otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"connect_master.api.send_otp"
							]
						},
						"description": "Sends a 6-digit OTP to the user's email address. If the user doesn't exist, it creates a new system user with the Customer role."
					},
					"response": []
				},
				{
					"name": "Verify OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "email",
									"value": "customer@example.com",
									"description": "Email address of the user logging in.",
									"type": "text"
								},
								{
									"key": "otp",
									"value": "123456",
									"description": "6-digit verification code received via email.",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/method/connect_master.api.verify_otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"connect_master.api.verify_otp"
							]
						},
						"description": "Verifies the OTP and logs in the user, returning standard session cookies (including `sid`)."
					},
					"response": []
				}
			]
		},
